<?xml version="1.0"?>
<launch>
	<!-- rosneuro pre-build nodes -->
	
		<!-- acquisition arguments -->
		<arg name="plugin" default='rosneuro::EGDDevice'/>
		<arg name="devarg" default='home/user/workspaces/rosneuro_ws/src/ah7.20170613.161402.offline.mi.mi_bhbf.gdf'/>
		<arg name="framerate" default='16'/>
		<arg name="samplerate" default='512'/>
		
		<!-- acquisition node -->
		<node name="acquisition_node" pkg="threshold_on_bandpower" type="acquisition" output="screen">
	  	  <param name="~plugin" value="$(arg plugin)"/>
	  	  <param name="~devarg" value="$(arg devarg)"/>
	  	  <param name="~samplerate" value="$(arg samplerate)"/>
	  	  <param name="~framerate"  value="$(arg framerate)"/>
	  	</node>
	  	
	  	
	  	<!-- load filter chain parameters -->
		<rosparam command="load" file="$(find threshold_on_bandpower)/config/ChainCfg.yaml" />
		
		<!-- filter chain node -->	
		<node name="filterchain_node" pkg="threshold_on_bandpower" type="filterchain" output="screen" >
			<param name="configname" value="ChainCfgList" />
		</node>	

	<!-- end rosneuro pre-build nodes -->
	
	
	<!-- project nodes -->
	
		<!-- thresholding node -->
		<node name="thresholding_node" pkg="threshold_on_bandpower" type="thresholding" output="screen">
	  	  <param name="channel"  value="1"/>
	  	  <param name="threshold"  value="10"/>
	  	</node>
	  	
	  	
	  	<!-- bandpower node -->
		<node name="bandpower_node" pkg="threshold_on_bandpower" type="bandpower" output="screen" />
	  	
	<!-- end project nodes -->
	
	
	<!-- rosbag node -->
	<arg name="record" default="false"/>
	<group if="$(arg record)">
		<node name="rosbag_record_node" pkg="rosbag" type="record" output="screen"
			args="-O /home/user/workspaces/rosneuro_ws/bags/record /eeg/filtered /eeg/bandpower /events/bus" />
	</group>		
	
</launch>
